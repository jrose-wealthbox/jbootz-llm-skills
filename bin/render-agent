#!/usr/bin/env ruby

require "json"
require "pathname"
require "psych"

SUPPORTED_HOSTS = {
  "claude-code" => %w[model tools],
  "codex" => %w[model model_reasoning_effort sandbox_mode],
}.freeze
COMMON_KEYS = %w[name description instructions hosts].freeze

def abort_with(message)
  warn "error: #{message}"
  exit 1
end

def require_string(mapping, key, context)
  value = mapping[key]
  abort_with("#{context} #{key} must be a non-empty string") unless value.is_a?(String) && !value.empty?
  value
end

agent_dir_arg, host = ARGV
abort_with("usage: render-agent AGENT_DIRECTORY [HOST]") unless agent_dir_arg && ARGV.length.between?(1, 2)

agent_dir = Pathname.new(agent_dir_arg).realpath
manifest_path = agent_dir.join("agent.yml")
abort_with("agent manifest is missing: #{manifest_path}") unless manifest_path.file?

begin
  manifest = Psych.safe_load_file(manifest_path, permitted_classes: [], permitted_symbols: [], aliases: false)
rescue Psych::Exception, SystemCallError => e
  abort_with("could not read #{manifest_path}: #{e.message}")
end

abort_with("agent manifest must contain a mapping: #{manifest_path}") unless manifest.is_a?(Hash)
unknown_common = manifest.keys - COMMON_KEYS
abort_with("unknown agent manifest keys in #{manifest_path}: #{unknown_common.join(', ')}") unless unknown_common.empty?

name = require_string(manifest, "name", manifest_path)
description = require_string(manifest, "description", manifest_path)
instructions_name = require_string(manifest, "instructions", manifest_path)
hosts = manifest["hosts"]
abort_with("#{manifest_path} hosts must be a non-empty mapping") unless hosts.is_a?(Hash) && !hosts.empty?

unknown_hosts = hosts.keys - SUPPORTED_HOSTS.keys
abort_with("unsupported hosts in #{manifest_path}: #{unknown_hosts.join(', ')}") unless unknown_hosts.empty?

hosts.each do |host_name, settings|
  abort_with("#{manifest_path} host #{host_name} must contain a mapping") unless settings.is_a?(Hash)
  unknown_settings = settings.keys - SUPPORTED_HOSTS.fetch(host_name)
  abort_with("unknown #{host_name} settings in #{manifest_path}: #{unknown_settings.join(', ')}") unless unknown_settings.empty?

  settings.each do |key, value|
    if key == "tools"
      unless value.is_a?(Array) && !value.empty? && value.all? { |tool| tool.is_a?(String) && !tool.empty? }
        abort_with("#{manifest_path} #{host_name}.tools must be a non-empty string array")
      end
    elsif !value.is_a?(String) || value.empty?
      abort_with("#{manifest_path} #{host_name}.#{key} must be a non-empty string")
    end
  end
end

begin
  instructions_path = agent_dir.join(instructions_name).realpath
rescue Errno::ENOENT
  abort_with("instruction file is missing: #{agent_dir.join(instructions_name)}")
end

unless instructions_path.file? && instructions_path.to_s.start_with?("#{agent_dir}/")
  abort_with("instruction file must be a regular file inside #{agent_dir}: #{instructions_path}")
end

instructions = instructions_path.read
abort_with("instruction file is empty: #{instructions_path}") if instructions.empty?

if host.nil?
  puts hosts.keys
  exit
end

abort_with("agent #{agent_dir.basename} does not support host #{host}") unless hosts.key?(host)
settings = hosts.fetch(host)
managed_text = "Generated by jbootz-llm-skills for #{agent_dir.basename}; edit agent.yml or #{instructions_name}."

case host
when "claude-code"
  puts "---"
  puts "# #{managed_text}"
  puts "name: #{JSON.generate(name)}"
  puts "description: #{JSON.generate(description)}"
  puts "model: #{JSON.generate(settings.fetch('model'))}" if settings.key?("model")
  puts "tools: #{settings.fetch('tools').join(', ')}" if settings.key?("tools")
  puts "---"
  puts
  print instructions
  puts unless instructions.end_with?("\n")
when "codex"
  puts "# #{managed_text}"
  puts "name = #{JSON.generate(name)}"
  puts "description = #{JSON.generate(description)}"
  %w[model model_reasoning_effort sandbox_mode].each do |key|
    puts "#{key} = #{JSON.generate(settings.fetch(key))}" if settings.key?(key)
  end
  puts
  puts "developer_instructions = #{JSON.generate(instructions)}"
end
